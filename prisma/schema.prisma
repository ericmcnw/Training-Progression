// Per-climb discipline. Today's session templates lock a session to one
// discipline (e.g. indoor-bouldering), but in practice a single gym/crag
// visit often mixes disciplines — bouldering then rope work, etc. Storing
// discipline per ClimbAttempt instead of deriving from the session template
// lets one session log a mix freely.
enum ClimbingDiscipline {
  BOULDER
  TOP_ROPE
  SPORT_LEAD
}

// ─── Endurance activity types ────────────────────────────────────────────────
// Unifies the old proliferation of per-subtype endurance routines (Run, Long
// Run, Trail Run, Hike, MTB, etc.) into a flat, type-driven model:
//
//   EnduranceFamily (Running, Walking, Cycling, Swimming, Rowing) — never
//   picked in the dropdown; exists only for rollups in the progress view.
//   Named with the Endurance prefix to avoid colliding with the top-level
//   ActivityFamily TS type ("endurance" | "sports" | …) in lib/activity-
//   families.ts, which is one abstraction level above this.
//
//   ActivityType (Run, Trail Run, Long Run, Walk, Hike, MTB, …) — the unit
//   the user picks at log time. Carries metric flags (hasDistance / Elevation
//   / Pace) so the form shows only relevant fields.
//
//   Logs reference an activityTypeId. Schedules + frequency goals can target
//   types and families polymorphically (see FrequencyGoal triggers below).
//
// All endurance logs share one synthetic "Endurance" routine in the Routine
// table (kind = CARDIO, isPlaceholder = true). Each log's display name comes
// from its activity type, not the synthetic routine — see
// getRoutineDisplayName(log).
model EnduranceFamily {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  types ActivityType[]

  @@index([sortOrder])
}

model ActivityType {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  familyId     String
  // Flat sort order within the dropdown — typically family generic first,
  // then specifics. Display layer uses (family.sortOrder, type.sortOrder).
  sortOrder    Int      @default(0)
  // Metric flags drive form field visibility. Distance + pace are nearly
  // universal; elevation matters for trail/hike but not flat road work.
  hasDistance  Boolean  @default(true)
  hasElevation Boolean  @default(false)
  hasPace      Boolean  @default(true)
  // Types that capture structured interval data (Interval Run, Sprint,
  // future hill repeats / swim sets etc.). When true the cardio form
  // surfaces the interval block (reps, work distance, work duration,
  // rest) and persists the values in RoutineLog.intervalsConfig.
  usesIntervals Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  family                EnduranceFamily              @relation(fields: [familyId], references: [id], onDelete: Restrict)
  routineLogs           RoutineLog[]
  routines              Routine[]
  scheduleEntries       ScheduleEntry[]
  manualScheduleEntries ScheduleManualEntry[]
  userPreferences       UserActivityTypePreference[]

  @@index([familyId, sortOrder])
  @@index([slug])
}

// Per-user preference for activity types — currently used to disable types
// the user doesn't track (e.g. hide swim rows if they don't swim). Defaults
// to enabled when no row exists, so a missing pref = visible. The app is
// single-user today, but the table is structured to add userId later if
// multi-user lands.
model UserActivityTypePreference {
  id             String   @id @default(cuid())
  activityTypeId String   @unique
  enabled        Boolean  @default(true)
  // Optional manual reorder within the dropdown; null = use type.sortOrder.
  sortOrder      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activityType ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Cascade)
}

enum ClimbMediaKind {
  PHOTO
  LINK
}

enum InjuryStatus {
  ACTIVE
  RECOVERING
  RESOLVED
  FLARED
}

// ZoneFreshness is derived in application code:
// FRESH, WORKED_TODAY, RECENTLY_WORKED, RECOVERING, INJURED

// Routine: a reusable training template a user logs against.
//
// Typing dimensions (read these together — they answer different questions):
//
//   kind    : the LOGGING SHAPE — what data this routine captures when logged.
//             COMPLETION (check-off), WORKOUT (sets+reps+weight), CARDIO
//             (distance/duration/elevation), GUIDED (step-by-step), SESSION
//             (sport-shaped, custom metrics, optional ClimbAttempt etc.).
//
//   subtype : a STYLE/VARIANT label within a kind (e.g., LONG_RUN vs RUN).
//             First-class metadata tags now carry the activity-type meaning
//             (running/biking/etc.); subtype is becoming a secondary label.
//
//   domain  : the DASHBOARD CLASSIFICATION — which training balance bar this
//             routine contributes to. UI options: strength, cardio, mobility,
//             sport, recovery. Derived from kind+subtype unless overridden.
//
// SESSION vs CARDIO — when the data shape is similar (both can have distance
// and duration), the rule is: SESSION is sport-shaped (climbing, surfing,
// basketball — has an identity beyond the metrics) and CARDIO is endurance-
// shaped (pace and distance are the point — running, biking, swimming).
//
// Habit tracking is NOT a domain — it's a behavior modifier. Any routine
// becomes a habit by attaching a FrequencyGoal. The Habits view is a lens
// over routines with FrequencyGoals, regardless of kind or domain.
model Routine {
  id           String      @id @default(cuid())
  name         String
  subtype      String?
  domain       String      @default("general")
  kind         RoutineKind @default(COMPLETION)
  timesPerWeek Int?
  isActive     Boolean     @default(true)
  // Activity type for endurance routines. Set on legacy endurance routines
  // by the type-migration script and on user-saved endurance routines via
  // the new create form. Null for non-endurance routines.
  activityTypeId String?

  // Sports this routine SUPPORTS but isn't a session of — the "Fingers
  // (hangboard) supports climbing" pattern. Distinct from the routine
  // BEING climbing (synthetic sports-climbing-synthetic routine or
  // legacy SESSION-kind routine with the climbing metadata tag).
  // Per-sport activity world pages read this to populate a "Training"
  // section alongside actual sport sessions. Slugs reference the
  // activity registry (lib/activity-families.ts) — typically "climbing",
  // "surfing", etc.
  supportsSports String[] @default([])

  // Placeholder routines are auto-created hosts for ad-hoc logs (e.g. one per
  // (domain, subtype) combo for Quick Workouts). They participate in Training
  // Balance and trigger-exercise goal matching, but are filtered out of every
  // user-facing routine list, picker, and goal-target dropdown.
  // The synthetic "Endurance" routine that holds all typed-endurance logs
  // also uses isPlaceholder = true.
  isPlaceholder Boolean @default(false)

  // Opt-in for COMPLETION routines that want to capture an optional duration
  // each session (cold plunge, sauna, massage, foam rolling, active recovery).
  // When true, the day-card checkbox stays a one-tap "done" but a minutes
  // pill renders next to it so the user can record duration after the fact.
  // Stats helpers treat null durations as "session done, minutes unrecorded"
  // — they're excluded from averages, not counted as zeros.
  capturesDuration Boolean @default(false)

  // soft delete (hide from UI, keep logs for progress)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs                  RoutineLog[]
  exercises             RoutineExercise[]
  guidedSteps           GuidedStep[]
  cardioDetails         CardioRoutineDetails?
  sessionDetails        SessionRoutineDetails?
  scheduleEntries       ScheduleEntry[]
  manualScheduleEntries ScheduleManualEntry[]
  metadataGroups        RoutineMetadataGroup[]
  tagAssignments        RoutineTagAssignment[]
  frequencyGoalRoutines FrequencyGoalRoutine[]
  activityType          ActivityType? @relation(fields: [activityTypeId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([isDeleted])
  @@index([kind, subtype])
  @@index([isPlaceholder])
  @@index([activityTypeId])
}

// ── Rotations ───────────────────────────────────────────────────────────────
// A rotation is an ordered list of slots (Push / Pull / Legs, Upper / Lower,
// a bro split, …) advanced by LOGGING, not the calendar. Each slot is
// satisfied by its primary routine OR any mapped covering activity (a climb
// covers Pull, a long hike covers Legs). The Plan page recommends the first
// unsatisfied slot in the current round. Distinct from the calendar-anchored
// SchedulePlan model — that fires routines on dates; this advances on logs.
model Rotation {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots RotationSlot[]

  @@index([isActive])
}

model RotationSlot {
  id         String @id @default(cuid())
  rotationId String
  position   Int    @default(0)
  name       String
  // The routine you'd normally do for this slot. Optional — a slot can be
  // satisfied purely by covering activities. Plain id (not an FK): routines
  // are soft-deleted, and any missing ref is handled in app code.
  primaryRoutineId String?

  rotation Rotation               @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  coverage RotationSlotCoverage[]

  @@index([rotationId, position])
}

model RotationSlotCoverage {
  id     String @id @default(cuid())
  slotId String
  // Exactly one identifies what counts for the slot:
  //   routineId — a specific routine (plain id, see RotationSlot note)
  //   tag       — an activity registry / metadata slug ("climbing", "running")
  routineId String?
  tag       String?

  slot RotationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId])
}

model SessionTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  sessionSubtype String?
  isSystem       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  metricDefinitions SessionMetricDefinition[]
  routines          SessionRoutineDetails[]
  metadataGroups    SessionTemplateMetadataGroup[]

  @@index([sortOrder, name])
  @@index([sessionSubtype])
}

model SchedulePlan {
  id              String   @id @default(cuid())
  name            String
  cycleLengthDays Int      @default(7)
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries    ScheduleEntry[]
  activation SchedulePlanActivation?
}

model ScheduleEntry {
  id             String   @id @default(cuid())
  schedulePlanId String
  routineId      String
  // Activity type for endurance schedule slots. When set + routineId points
  // at the synthetic Endurance routine, the slot renders as the type name
  // ("Run Tuesday") rather than the generic "Endurance" placeholder. Null
  // for non-endurance schedule entries.
  activityTypeId String?
  dayOffset      Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedulePlan SchedulePlan  @relation(fields: [schedulePlanId], references: [id], onDelete: Cascade)
  routine      Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  activityType ActivityType? @relation(fields: [activityTypeId], references: [id], onDelete: SetNull)

  @@index([schedulePlanId, dayOffset, sortOrder])
  @@index([routineId])
  @@index([activityTypeId])
}

model SchedulePlanActivation {
  id             String   @id @default(cuid())
  schedulePlanId String   @unique
  isEnabled      Boolean  @default(false)
  startDate      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedulePlan SchedulePlan @relation(fields: [schedulePlanId], references: [id], onDelete: Cascade)
}

model ScheduleManualEntry {
  id            String   @id @default(cuid())
  routineId     String
  // Activity type for ad-hoc typed endurance schedule slots (same semantics
  // as ScheduleEntry.activityTypeId). Null for non-endurance entries.
  activityTypeId String?
  scheduledDate DateTime
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  routine      Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  activityType ActivityType? @relation(fields: [activityTypeId], references: [id], onDelete: SetNull)

  @@index([scheduledDate, sortOrder])
  @@index([routineId])
  @@index([activityTypeId])
}

model ClimbLocation {
  id        String            @id @default(cuid())
  name      String
  type      ClimbLocationType
  // Optional broader area context (city/state/region) — e.g. "Bishop, CA"
  // for "Buttermilks". Replaces the free-text RoutineLog.location field for
  // climbing sessions; structured here so it's reusable across logs.
  region    String?
  // Geo coords are optional — locations can exist as label-only and have
  // coords added later from the climbing map page.
  latitude  Float?
  longitude Float?
  // OpenStreetMap place identity — when the user picks a spot from the
  // Nominatim autocomplete we store the stable osm_type+osm_id pair so
  // future picks of the same OSM place link to this existing record
  // instead of duplicating. Null for spots created without OSM (manual
  // names, GPS-only, undocumented boulders, etc.).
  osmType   String?
  osmId     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  routineLogs RoutineLog[]
  problems    ClimbProblem[]
  media       ClimbMedia[]
  areas       ClimbArea[]

  @@index([type, name])
  @@index([osmType, osmId])
}

// Named sub-region of a ClimbLocation — sectors, walls, boulders within a
// crag/gym. Lives under one location and is referenced by ClimbAttempt so
// you can log multiple climbs at "Cave Wall" and filter by it later.
// Names are case-insensitive within a location (the dedup runs on lower-
// case in the resolver). The free-text ClimbAttempt.area column stays
// alongside for legacy display fallback on rows that predate the FK.
model ClimbArea {
  id         String        @id @default(cuid())
  locationId String
  name       String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt

  location  ClimbLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  attempts  ClimbAttempt[]
  media     ClimbMedia[]

  @@unique([locationId, name])
  @@index([locationId])
}

// Generic location pin for non-climbing activities (Phase 2 of the spots-map
// feature). Each spot belongs to a specific activity slug (matches
// MetadataGroup.slug / activity-families registry). Climbing keeps its own
// ClimbLocation model — that one ties to ClimbProblem and is stricter about
// type. ActivitySpot is the loose, per-activity equivalent.
model ActivitySpot {
  id           String   @id @default(cuid())
  activitySlug String
  name         String
  // Free-form per-activity convention: "indoor"/"outdoor" for ball sports,
  // "trail"/"peak"/"trailhead" for hiking, etc. Nullable when an activity
  // doesn't use sub-types.
  type         String?
  // Optional broader area context (city/state/region) — same purpose as
  // ClimbLocation.region. Shown next to name in pickers for disambiguation.
  region       String?
  latitude     Float?
  longitude    Float?
  // OpenStreetMap place identity (osm_type + osm_id). Same purpose as
  // ClimbLocation.osm* — dedup the picker so a single OSM place doesn't
  // generate parallel records across activities.
  osmType      String?
  osmId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  routineLogs RoutineLog[]

  @@index([activitySlug, name])
  @@index([osmType, osmId])
}

model ClimbProblem {
  id          String           @id @default(cuid())
  name        String
  grade       String
  gradeSystem ClimbGradeSystem
  notes       String?
  locationId  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  location ClimbLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  attempts ClimbAttempt[]
  media    ClimbMedia[]

  @@index([locationId, grade])
  @@index([name])
}

// Photos and external links attached to a ClimbLocation, ClimbArea, or
// ClimbProblem. Exactly one of locationId / areaId / problemId is set per
// row — enforced in the server action, not at the DB level (Postgres CHECK
// constraints get noisy in Prisma migrations).
//
// Storage: PHOTO rows point at a URL we own (e.g. /uploads/climbing/yyyy/mm/
// {cuid}.jpg in dev; Vercel Blob or R2 in prod). LINK rows point at an
// external URL (YouTube, Imgur, etc.) — no upload, just metadata.
model ClimbMedia {
  id           String         @id @default(cuid())
  kind         ClimbMediaKind
  url          String
  thumbnailUrl String?
  caption      String?
  width        Int?
  height       Int?
  sizeBytes    Int?
  // Hand-ordered position within the parent's gallery. Lower = first.
  // Default 0; new uploads append by writing max(sortOrder)+1.
  sortOrder    Int            @default(0)

  locationId String?
  location   ClimbLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  areaId     String?
  area       ClimbArea?     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  problemId  String?
  problem    ClimbProblem?  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([locationId, sortOrder])
  @@index([areaId, sortOrder])
  @@index([problemId, sortOrder])
}

model ClimbAttempt {
  id             String             @id @default(cuid())
  sessionLogId   String
  problemId      String?
  // Per-climb discipline. Required for new logs; backfilled from session
  // template for historical rows. The grade system + available outcomes are
  // both derived from discipline at the UI layer.
  discipline     ClimbingDiscipline @default(BOULDER)
  grade          String
  gradeSystem    ClimbGradeSystem
  outcome        ClimbOutcome
  // Free-text area kept alongside the structured FK for legacy rows that
  // predate the migration. New rows populate `areaId` and may leave this
  // null; lists prefer `climbArea.name` when present, else fall back here.
  area           String?
  areaId         String?
  movesCompleted Int?
  totalMoves     Int?
  // Optional "how many tries" counter. Used for SEND/REDPOINT only —
  // implicitly 1 for FLASH/ONSIGHT and meaningless for PROJECT (it's still
  // in progress). Null for historical rows before this field existed.
  triesCount     Int?
  notes          String?
  attemptOrder   Int                @default(0)
  createdAt      DateTime           @default(now())

  sessionLog RoutineLog    @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  problem    ClimbProblem? @relation(fields: [problemId], references: [id], onDelete: SetNull)
  climbArea  ClimbArea?    @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([sessionLogId, attemptOrder])
  @@index([gradeSystem, grade])
  @@index([problemId])
  @@index([areaId])
}

model RoutineLog {
  id              String   @id @default(cuid())
  routineId       String
  performedAt     DateTime @default(now())
  notes           String?
  completionCount Int?
  durationSec     Int?
  distanceMi      Float?
  elevationGainFt Int?
  // Perceived effort 1-10 (Borg-style RPE) for cardio + sport logs. Drives
  // the strain model: load = duration × convexWeight(effort), which feeds the
  // body map + training-load charts. Editable/backfillable per log. Null for
  // logs without a rating (historical, strength, or skipped).
  effort          Int?
  location        String?
  climbLocationId String?
  activitySpotId  String?
  // Activity type for endurance logs. Required for new endurance logs at
  // the UI layer (the form picks/inherits a type); null for non-endurance
  // logs and for historical endurance logs before the type migration.
  // Display name resolution prefers activityType.name when present (see
  // getRoutineDisplayName).
  activityTypeId  String?
  // Structured interval data for types where activityType.usesIntervals
  // is true (Interval Run, Sprint, etc.). Shape: { reps: number,
  // workDistanceM?: number, workDurationSec?: number, restSec?: number,
  // targetPaceSecPerMi?: number }. Null for non-interval logs and for
  // interval logs created before this field landed.
  intervalsConfig Json?
  // Sport-specific structured data — shape varies by sport, all of
  // them discriminated by the leading `sport` field. Today used by
  // golf (round mode + per-hole or per-club detail); future sports
  // populate this with their own discriminated shape. Null for
  // sports without a rich schema yet (basketball, snowboarding,
  // surfing — they keep using the minimal duration+notes log form).
  //   Golf: { sport: "golf", mode: "COURSE" | "RANGE",
  //     course?: { location?, holes: Array<{ number, par, score,
  //       club?, notes? }> },
  //     range?: { ballCount?, shots: Array<{ club, distanceYards?,
  //       ballCount?, notes? }> } }
  sportData Json?

  // Weather snapshot captured at save time for outdoor-eligible logs (sport
  // + endurance). Permanent point-in-time record so it never changes if the
  // provider is swapped later. Shape: lib/weather.ts WeatherSnapshot
  //   { tempF, feelsLikeF, code, windMph, precipIn, humidity, lat, lng,
  //     source, fetchedAt }. Null for logs without coords, indoor strength/
  //     mobility logs, and anything logged before this landed.
  weather Json?

  // Multi-day backpacking: a trip is a BackpackingTrip parent + one RoutineLog
  // per day (so each day shows natively on the WaG / schedule / charts and
  // per-day miles attribute correctly). Null for every non-backpacking log.
  backpackingTripId String?

  routine       Routine        @relation(fields: [routineId], references: [id], onDelete: Cascade)
  climbLocation ClimbLocation? @relation(fields: [climbLocationId], references: [id], onDelete: SetNull)
  activitySpot  ActivitySpot?  @relation(fields: [activitySpotId], references: [id], onDelete: SetNull)
  activityType  ActivityType?  @relation(fields: [activityTypeId], references: [id], onDelete: SetNull)
  backpackingTrip BackpackingTrip? @relation(fields: [backpackingTripId], references: [id], onDelete: Cascade)

  exercises           SessionExercise[]
  guidedSteps         GuidedStepLog[]
  metrics             RoutineLogMetric[]
  sessionMetricValues SessionLogMetricValue[]
  stimuli             RoutineLogStimulus[]
  zoneActivities      ZoneActivity[]
  painLogs            PainLog[]
  climbAttempts       ClimbAttempt[]
  gearLinks           RoutineLogGear[]

  createdAt DateTime @default(now())

  @@index([routineId, performedAt])
  @@index([climbLocationId])
  @@index([activitySpotId])
  @@index([activityTypeId, performedAt])
  @@index([backpackingTripId])
}

// A multi-day backpacking trip. Parent of N day-logs (RoutineLog rows, one per
// day on the trail). Holds the trip-level data that doesn't belong on any single
// day: trail, trailhead/area, overall gear list + pack weight. Per-day miles /
// elevation / campsite live on each day-log's sportData. Soft data; deleting a
// trip cascades its day-logs.
model BackpackingTrip {
  id              String   @id @default(cuid())
  profileKey      String
  routineId       String   // the synthetic backpacking routine (domain=cardio)
  trail           String?  // overall route, e.g. "John Muir Trail"
  location        String?  // display name of the trailhead / area
  activitySpotId  String?  // ActivitySpot FK for the trailhead / area
  startYmd        String   // first day on trail (YYYY-MM-DD)
  endYmd          String   // last day on trail
  totalMiles      Float?   // sum of day miles (denormalized for quick reads)
  // Inline gear snapshot: [{ name, weightGrams?, quantity?, consumable? }].
  // The future Gear/loadout tables will populate this, not replace it.
  gear            Json?
  packWeightGrams Int?     // total carried weight at trip time (snapshot)
  baseWeightGrams Int?     // total excluding consumables
  notes           String?
  effort          Int?     // perceived effort 1-10 for the trip
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dayLogs RoutineLog[]

  @@index([profileKey, startYmd])
}

// A generic multi-day span shown as a bar across the Week-at-a-glance — a
// vacation, travel, illness, or any stretch worth marking. Unlike a backpacking
// trip (which IS activity), a DaySpan usually EXPLAINS a dip in activity. Pure
// annotation: no logs attached.
model DaySpan {
  id         String   @id @default(cuid())
  profileKey String
  kind       String   // "vacation" | "travel" | "away" | "sick" | "rest" | "other"
  label      String
  icon       String?  // optional custom emoji, overrides the kind's default glyph
  startYmd   String
  endYmd     String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileKey, startYmd])
}

// Owned gear — a reusable inventory item (footwear, tent, snowboard, …) picked
// on logs and reused across them. `activitySlug` null = universal (shows on any
// log, e.g. footwear); set = scoped to that activity + its compatibles. `type`
// is a gear-type slug (see lib/gear-types.ts) driving icon + lifetime unit.
model Gear {
  id           String    @id @default(cuid())
  profileKey   String
  type         String
  name         String
  weightGrams  Int?
  activitySlug String?
  consumable   Boolean   @default(false)
  retiredAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logLinks  RoutineLogGear[]
  listItems GearListItem[]

  @@index([profileKey, retiredAt])
}

// A named, reusable collection of gear. Used two ways with no `kind` field —
// it's a distinction of verb, not type: you *pack* against it (interactive
// checklist) and you *apply* it to a log (loadout). The list is a template; the
// log's gear snapshot is the per-trip instance, so applying copies items into
// the picker and never mutates the list. `activitySlug` scopes which logs it can
// seed (universal gear like footwear still fits any list).
model GearList {
  id           String   @id @default(cuid())
  profileKey   String
  name         String
  activitySlug String?
  notes        String?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items GearListItem[]

  @@index([profileKey, isDeleted])
}

// One row in a gear list. `label` is ALWAYS present (the display text) so
// deleting a linked Gear never blanks the row — gearId goes null, label stays.
// `gearId` is the optional inventory link (carries weight/type/usage); a pure
// non-inventory item (sunscreen, permit, 2 L water) has a label + no gearId.
// `checked` is the persisted "bringing / in my pack" state the checklist toggles.
model GearListItem {
  id                  String  @id @default(cuid())
  listId              String
  label               String
  gearId              String?
  weightGramsOverride Int?
  consumable          Boolean @default(false)
  quantity            Int     @default(1)
  checked             Boolean @default(true)
  sortOrder           Int     @default(0)

  list GearList @relation(fields: [listId], references: [id], onDelete: Cascade)
  gear Gear?    @relation(fields: [gearId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([gearId])
}

// Gear ↔ log link — records which gear was used on a log so usage rolls up
// (shoe miles, board days, …). Backpacking keeps its own trip snapshot; this is
// for snapshot-less logs (cardio, sport sessions).
model RoutineLogGear {
  routineLogId String
  gearId       String
  createdAt    DateTime @default(now())

  routineLog RoutineLog @relation(fields: [routineLogId], references: [id], onDelete: Cascade)
  gear       Gear       @relation(fields: [gearId], references: [id], onDelete: Cascade)

  @@id([routineLogId, gearId])
  @@index([gearId])
}

