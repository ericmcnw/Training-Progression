model Goal {
  id          String         @id @default(cuid())
  name        String
  goalType    GoalType
  targetType  GoalTargetType
  targetId    String
  metricType  GoalMetricType
  targetValue Float
  timeframe   GoalTimeframe
  unit        String?
  startDate   DateTime       @default(now())
  endDate     DateTime?
  isActive    Boolean        @default(true)
  notes       String?
  config      Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isActive, goalType])
  @@index([targetType, targetId])
  @@index([timeframe, startDate, endDate])
}

model FrequencyGoal {
  id             String               @id @default(cuid())
  name           String
  targetCount    Int
  targetInterval Int
  targetUnit     RoutineFrequencyUnit
  // Weekday bitmask: bit 0 = Sun, bit 1 = Mon, ..., bit 6 = Sat. Null/zero
  // means "any day counts" (flexible weekly target). Only meaningful when
  // targetUnit = WEEK; ignored for DAY/MONTH targets.
  weekdayMask    Int?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Optional broaden-the-net config. A log counts toward this goal when
  // log.routineId is in `routines` (existing PRIMARY/SUBSTITUTE) OR the
  // log's routine has a subtype in `triggerSubtypes` OR the log has an
  // activityTypeId in `triggerActivityTypeIds` OR the log's activity type
  // belongs to a family in `triggerActivityFamilyIds` OR any exercise
  // inside the log is in `triggerExercises`. Used to catch ad-hoc / quick
  // logs that aren't members of a saved routine the user already listed.
  // Activity-type triggers are the v1 entry point for endurance goals —
  // e.g. "Run 3x/wk" sets triggerActivityFamilyIds=[<running>] and any
  // run-family log counts.
  triggerSubtypes          String[]                       @default([])
  triggerActivityTypeIds   String[]                       @default([])
  triggerActivityFamilyIds String[]                       @default([])
  triggerExercises         FrequencyGoalTriggerExercise[]
  // Minimum number of trigger-exercise sets a log must contain to claim a
  // session via the exercise-trigger path. 1 = any set counts (default).
  // Higher values stop a single warmup pull-up from claiming a Pull
  // Strength session. Ignored for routine-id and subtype matches —
  // they're already routine-level claims.
  triggerMinSets   Int                            @default(1)
  // Domain-wide targeting: a log counts when its routine's effective domain
  // matches ("strength" | "cardio" | "mobility" | "sport" | "lifestyle"),
  // or "any" to count every training log. Null = not a domain goal.
  targetDomain     String?
  // Sport-tag targeting: a log counts when its routine's supportsSports
  // overlaps this list — "training FOR climbing, 2×/wk" without listing
  // each routine by hand.
  triggerSupportedSports String[]                 @default([])
  // Per-session aim, display-only (show-don't-gate): "5×/wk aiming ~30
  // reps" renders each session as 20/30, 34/30 — a session below the aim
  // still counts toward the frequency target.
  sessionAim       Int?

  routines FrequencyGoalRoutine[]

  @@index([isActive])
}

model FrequencyGoalRoutine {
  goalId    String
  routineId String
  // PRIMARY: counts as a real completion of the goal — what the habit is
  // really tracking. SUBSTITUTE: another routine that satisfies the day
  // (so the streak doesn't break) but renders as "covered by" instead of
  // "done" in the heatmap. Default PRIMARY keeps existing rows unchanged.
  role      FrequencyGoalRole @default(PRIMARY)
  addedAt   DateTime          @default(now())

  goal    FrequencyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  routine Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([goalId, routineId])
  @@index([routineId])
}

// Exercise-based "also count when these appear" rule. A goal with even one
// row here will pick up any log that contains the exercise — including quick
// workout logs that aren't part of an enrolled routine. See the matcher in
// lib/frequency-goals.ts for the OR'd evaluation order.
model FrequencyGoalTriggerExercise {
  goalId     String
  exerciseId String
  addedAt    DateTime @default(now())

  goal     FrequencyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  exercise Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([goalId, exerciseId])
  @@index([exerciseId])
}

enum FrequencyGoalRole {
  PRIMARY
  SUBSTITUTE
}

// Persistent goal history — the record that goals "remember". One row per
// event; `lineageId` groups a goal's promotion ladder (45×5 → 60×5) into one
// track for step-charts and history timelines. `goalId` is a plain string
// spanning BOTH goal stores (Goal cuids and FrequencyGoal ids incl. the
// deterministic `fg_<routineId>` companions) — intentionally no FK so one
// table covers the split storage.
//   ACHIEVED   — a milestone (one-time) goal's target was reached; value is
//                the target at that moment. Latched idempotently on read via
//                the unique constraint.
//   BAR_RAISED — the goal's target changed to `value` (promotion on a
//                milestone track, or a recurring goal's standing bar moving
//                3×/wk → 4×/wk). Written by the update paths.
model GoalMilestone {
  id         String            @id @default(cuid())
  goalId     String
  lineageId  String
  kind       GoalMilestoneKind
  value      Float
  valueLabel String?
  achievedAt DateTime          @default(now())
  createdAt  DateTime          @default(now())

  @@unique([goalId, kind, value])
  @@index([lineageId, achievedAt])
  @@index([goalId])
}

enum GoalMilestoneKind {
  ACHIEVED
  BAR_RAISED
}

// Lightweight, date-bound to-do items for "random not-important" things the
// user wants to check off for a specific day (e.g., laundry, doctor's
// appointment). Distinct from routines/habits — no streak math, no history
// of completion patterns; once done it just sits checked off on its day.
model DayTodo {
  id        String   @id @default(cuid())
  ymd       String   // app-tz YYYY-MM-DD the todo belongs to
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ymd, done])
  @@index([done, ymd])
}

// ── Focus + Progression roadmap (Phase 1) ────────────────────────────────
// A Focus is a strategic, time-bound objective (e.g. "Fall Climbing Prep")
// that groups existing routines/activities/goals via FocusContributor and
// auto-aggregates their logs. Its progression roadmap is a set of
// ProgressionMilestones. Milestones can also belong to an ActiveInjury
// (continuous rehab path) — see ownerKind. Phase 1 is deliberately minimal:
// no gates, projection, seasons, or structured targets yet.

enum FocusStatus {
  PLANNED
  ACTIVE
  ACHIEVED
  PAUSED
  ABANDONED
}

enum FocusTargetKind {
  // Slides automatically as the roadmap projects forward.
  SOFT
  // World-driven deadline (first snow, a trip date). Never slides from the
  // roadmap; the user drags it when reality changes. Drift past it is surfaced.
  HARD
}

enum FocusPhase {
  // Capacity-building (milestones are progressions).
  BUILD
  // In-season / peak (milestones are outcomes — sends, etc.).
  PEAK
  // Down / recovery period.
  OFFSEASON
  // Hold steady (frequency, not progression).
  MAINTAIN
}

enum FocusContributorKind {
  ACTIVITY_FAMILY
  ACTIVITY_TYPE
  SPORT
  ROUTINE
  EXERCISE
  FREQUENCY_GOAL
}

enum MilestoneOwnerKind {
  FOCUS
  INJURY
}

enum MilestoneScopeKind {
  ROUTINE
  EXERCISE
  CAPACITY
}

enum MilestoneStatus {
  ACTIVE
  ACHIEVED
  SKIPPED
}

enum MilestoneGateKind {
  // No advance condition — advance whenever you decide.
  NONE
  // Free-text criteria you self-assess ("nerve line quiet").
  FREE_TEXT
  // Pain-reading condition, auto-evaluated from PainLog: reading stays ≤
  // threshold across the last N days for a zone.
  PAIN
  // Frequency condition, auto-evaluated from RoutineLog: the track's routine
  // averaged ≥ N sessions/week over the last M weeks ("done it enough").
  FREQUENCY
}

model Focus {
  id             String        @id @default(cuid())
  name           String
  description    String?
  status         FocusStatus   @default(ACTIVE)
  sortOrder      Int           @default(0)
  color          String?
  icon           String?
  // Timeline (Phase 2). targetDate = when it should be done; targetKind says
  // whether that slides with the plan (SOFT) or is world-fixed (HARD).
  targetDate     DateTime?
  targetKind     FocusTargetKind @default(SOFT)
  // Seasonality. season = free label ("Summer '26"); phase = build/peak/etc;
  // handoffNote = what this becomes next ("→ Fall: send season").
  season         String?
  phase          FocusPhase?
  handoffNote    String?
  // Sport slug / activity-family / domain this focus belongs to; renders its
  // seasonal arc on that world page. Null for cross-cutting focuses.
  pursuitKey     String?
  // Optional link to an ActiveInjury the focus "nods" to (rehab focuses).
  linkedInjuryId String?
  linkedInjury   ActiveInjury? @relation(fields: [linkedInjuryId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  contributors FocusContributor[]

  @@index([status, sortOrder])
}

model FocusContributor {
  id      String               @id @default(cuid())
  focusId String
  focus   Focus                @relation(fields: [focusId], references: [id], onDelete: Cascade)
  kind    FocusContributorKind
  // Polymorphic id whose meaning depends on kind: activityFamilyId /
  // activityTypeId / sport slug / routineId / exerciseId / frequencyGoalId.
  refId   String
  createdAt DateTime @default(now())

  @@unique([focusId, kind, refId])
  @@index([focusId])
}

model ProgressionMilestone {
  id        String             @id @default(cuid())
  // Polymorphic owner — a roadmap belongs to a Focus (seasonal) OR an
  // ActiveInjury (continuous rehab path). ownerId is intentionally NOT a hard
  // FK (it points at two tables); integrity is enforced in the app layer.
  ownerKind MilestoneOwnerKind
  ownerId   String
  // Scope groups milestones into implicit tracks and drives the WaG aim
  // lookup: a routine's aim = its first ACTIVE milestone scoped to it.
  scopeKind MilestoneScopeKind
  // routineId / exerciseId / free-text capacity label, per scopeKind.
  scopeRef  String?
  label      String
  targetText String?
  status     MilestoneStatus @default(ACTIVE)
  sortOrder  Int             @default(0)
  // Timeline (Phase 2). estDurationDays drives the forward projection; a
  // milestone can also wait on another (cross-track) via dependsOnMilestoneId
  // — its projected start is max(prior-in-track end, dependency end).
  estDurationDays     Int?
  dependsOnMilestoneId String?
  // Advance gate (Phase 2). PAIN gates auto-evaluate from PainLog; FREE_TEXT is
  // self-assessed. gatePain* only meaningful when gateKind = PAIN.
  gateKind          MilestoneGateKind @default(NONE)
  gateNote          String?
  gatePainZoneId    String?
  gatePainThreshold Int?
  gatePainDays      Int?
  // FREQUENCY only: sessions/week target + evaluation window in weeks.
  gateFreqPerWeek   Float?
  gateFreqWeeks     Int?
  achievedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([ownerKind, ownerId, sortOrder])
  @@index([scopeKind, scopeRef, status])
}

// ── AI coach (Slice 3) ─────────────────────────────────────────────────────
// Conversation persistence so coach chats survive refresh. One thread = one
// conversation; summary holds a rolling compression of messages older than
// the live window (summarizedCount = how many messages the summary covers).

model CoachThread {
  id              String         @id @default(cuid())
  title           String?
  summary         String?
  summarizedCount Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        CoachMessage[]

  @@index([updatedAt])
}

model CoachMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    CoachThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
}
