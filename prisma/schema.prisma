generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoutineKind {
  COMPLETION
  WORKOUT
  CARDIO
  GUIDED
  SESSION
}

enum RoutineFrequencyUnit {
  DAY
  WEEK
  MONTH
}

enum ExerciseUnit {
  REPS
  TIME
}

enum ExerciseLibraryKind {
  STRENGTH
  CONDITIONING
  MOBILITY
  STRETCH
  BREATHWORK
  SKILL
}

enum MetadataGroupKind {
  MUSCLE_GROUP
  MOVEMENT_PATTERN
  TRAINING_GROUP
  CARDIO_ACTIVITY
  ROUTINE_FOCUS
}

enum GoalType {
  FREQUENCY
  VOLUME
  PERFORMANCE
  COMPLETION
}

enum GoalTargetType {
  ROUTINE
  EXERCISE
  CARDIO
  GROUP
  SESSION_TEMPLATE
}

enum GoalTimeframe {
  DAY
  WEEK
  MONTH
  ONE_TIME
}

enum GoalMetricType {
  SESSIONS
  DISTANCE
  DURATION
  ELEVATION_GAIN
  VOLUME
  REPS
  SETS
  MAX_WEIGHT
  MAX_DURATION
  PACE
  COMPLETED
  SESSION_METRIC
}

enum SessionMetricValueType {
  INTEGER
  DECIMAL
  TEXT
  BOOLEAN
}

enum GuidedStepKind {
  STEP
  EXERCISE
}

enum Side {
  LEFT
  RIGHT
  BILATERAL
  CENTRAL
}

enum BodyView {
  FRONT
  BACK
  BOTH
}

enum ActivitySource {
  EXERCISE
  SPORT_TAG
  MANUAL
}

enum PainContext {
  AT_REST
  DURING_ACTIVITY
  AFTER_ACTIVITY
  MORNING
  GENERAL
}

enum ClimbOutcome {
  FLASH
  ONSIGHT
  SEND
  REDPOINT
  FELL
  PROJECT
}

enum ClimbLocationType {
  GYM
  CRAG
}

enum ClimbGradeSystem {
  BOULDER_V
  YOSEMITE
}

enum InjuryStatus {
  ACTIVE
  RECOVERING
  RESOLVED
  FLARED
}

// ZoneFreshness is derived in application code:
// FRESH, WORKED_TODAY, RECENTLY_WORKED, RECOVERING, INJURED

// Routine: a reusable training template a user logs against.
//
// Typing dimensions (read these together — they answer different questions):
//
//   kind    : the LOGGING SHAPE — what data this routine captures when logged.
//             COMPLETION (check-off), WORKOUT (sets+reps+weight), CARDIO
//             (distance/duration/elevation), GUIDED (step-by-step), SESSION
//             (sport-shaped, custom metrics, optional ClimbAttempt etc.).
//
//   subtype : a STYLE/VARIANT label within a kind (e.g., LONG_RUN vs RUN).
//             First-class metadata tags now carry the activity-type meaning
//             (running/biking/etc.); subtype is becoming a secondary label.
//
//   domain  : the DASHBOARD CLASSIFICATION — which training balance bar this
//             routine contributes to. UI options: strength, cardio, mobility,
//             sport, recovery. Derived from kind+subtype unless overridden.
//
// SESSION vs CARDIO — when the data shape is similar (both can have distance
// and duration), the rule is: SESSION is sport-shaped (climbing, surfing,
// basketball — has an identity beyond the metrics) and CARDIO is endurance-
// shaped (pace and distance are the point — running, biking, swimming).
//
// Habit tracking is NOT a domain — it's a behavior modifier. Any routine
// becomes a habit by attaching a FrequencyGoal. The Habits view is a lens
// over routines with FrequencyGoals, regardless of kind or domain.
model Routine {
  id           String      @id @default(cuid())
  name         String
  subtype      String?
  domain       String      @default("general")
  kind         RoutineKind @default(COMPLETION)
  timesPerWeek Int?
  isActive     Boolean     @default(true)

  // Placeholder routines are auto-created hosts for ad-hoc logs (e.g. one per
  // (domain, subtype) combo for Quick Workouts). They participate in Training
  // Balance and trigger-exercise goal matching, but are filtered out of every
  // user-facing routine list, picker, and goal-target dropdown.
  isPlaceholder Boolean @default(false)

  // soft delete (hide from UI, keep logs for progress)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs                  RoutineLog[]
  exercises             RoutineExercise[]
  guidedSteps           GuidedStep[]
  cardioDetails         CardioRoutineDetails?
  sessionDetails        SessionRoutineDetails?
  scheduleEntries       ScheduleEntry[]
  manualScheduleEntries ScheduleManualEntry[]
  metadataGroups        RoutineMetadataGroup[]
  tagAssignments        RoutineTagAssignment[]
  frequencyGoalRoutines FrequencyGoalRoutine[]

  @@index([isActive])
  @@index([isDeleted])
  @@index([kind, subtype])
  @@index([isPlaceholder])
}

model SessionTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  sessionSubtype String?
  isSystem       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  metricDefinitions SessionMetricDefinition[]
  routines          SessionRoutineDetails[]
  metadataGroups    SessionTemplateMetadataGroup[]

  @@index([sortOrder, name])
  @@index([sessionSubtype])
}

model SchedulePlan {
  id              String   @id @default(cuid())
  name            String
  cycleLengthDays Int      @default(7)
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries    ScheduleEntry[]
  activation SchedulePlanActivation?
}

model ScheduleEntry {
  id             String   @id @default(cuid())
  schedulePlanId String
  routineId      String
  dayOffset      Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedulePlan SchedulePlan @relation(fields: [schedulePlanId], references: [id], onDelete: Cascade)
  routine      Routine      @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([schedulePlanId, dayOffset, sortOrder])
  @@index([routineId])
}

model SchedulePlanActivation {
  id             String   @id @default(cuid())
  schedulePlanId String   @unique
  isEnabled      Boolean  @default(false)
  startDate      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedulePlan SchedulePlan @relation(fields: [schedulePlanId], references: [id], onDelete: Cascade)
}

model ScheduleManualEntry {
  id            String   @id @default(cuid())
  routineId     String
  scheduledDate DateTime
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([scheduledDate, sortOrder])
  @@index([routineId])
}

model ClimbLocation {
  id        String            @id @default(cuid())
  name      String
  type      ClimbLocationType
  // Optional broader area context (city/state/region) — e.g. "Bishop, CA"
  // for "Buttermilks". Replaces the free-text RoutineLog.location field for
  // climbing sessions; structured here so it's reusable across logs.
  region    String?
  // Geo coords are optional — locations can exist as label-only and have
  // coords added later from the climbing map page.
  latitude  Float?
  longitude Float?
  // OpenStreetMap place identity — when the user picks a spot from the
  // Nominatim autocomplete we store the stable osm_type+osm_id pair so
  // future picks of the same OSM place link to this existing record
  // instead of duplicating. Null for spots created without OSM (manual
  // names, GPS-only, undocumented boulders, etc.).
  osmType   String?
  osmId     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  routineLogs RoutineLog[]
  problems    ClimbProblem[]

  @@index([type, name])
  @@index([osmType, osmId])
}

// Generic location pin for non-climbing activities (Phase 2 of the spots-map
// feature). Each spot belongs to a specific activity slug (matches
// MetadataGroup.slug / activity-families registry). Climbing keeps its own
// ClimbLocation model — that one ties to ClimbProblem and is stricter about
// type. ActivitySpot is the loose, per-activity equivalent.
model ActivitySpot {
  id           String   @id @default(cuid())
  activitySlug String
  name         String
  // Free-form per-activity convention: "indoor"/"outdoor" for ball sports,
  // "trail"/"peak"/"trailhead" for hiking, etc. Nullable when an activity
  // doesn't use sub-types.
  type         String?
  // Optional broader area context (city/state/region) — same purpose as
  // ClimbLocation.region. Shown next to name in pickers for disambiguation.
  region       String?
  latitude     Float?
  longitude    Float?
  // OpenStreetMap place identity (osm_type + osm_id). Same purpose as
  // ClimbLocation.osm* — dedup the picker so a single OSM place doesn't
  // generate parallel records across activities.
  osmType      String?
  osmId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  routineLogs RoutineLog[]

  @@index([activitySlug, name])
  @@index([osmType, osmId])
}

model ClimbProblem {
  id          String           @id @default(cuid())
  name        String
  grade       String
  gradeSystem ClimbGradeSystem
  notes       String?
  locationId  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  location ClimbLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  attempts ClimbAttempt[]

  @@index([locationId, grade])
  @@index([name])
}

model ClimbAttempt {
  id             String           @id @default(cuid())
  sessionLogId   String
  problemId      String?
  grade          String
  gradeSystem    ClimbGradeSystem
  outcome        ClimbOutcome
  area           String?
  movesCompleted Int?
  totalMoves     Int?
  notes          String?
  attemptOrder   Int              @default(0)
  createdAt      DateTime         @default(now())

  sessionLog RoutineLog    @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  problem    ClimbProblem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([sessionLogId, attemptOrder])
  @@index([gradeSystem, grade])
  @@index([problemId])
}

model RoutineLog {
  id              String   @id @default(cuid())
  routineId       String
  performedAt     DateTime @default(now())
  notes           String?
  completionCount Int?
  durationSec     Int?
  distanceMi      Float?
  elevationGainFt Int?
  location        String?
  climbLocationId String?
  activitySpotId  String?

  routine       Routine        @relation(fields: [routineId], references: [id], onDelete: Cascade)
  climbLocation ClimbLocation? @relation(fields: [climbLocationId], references: [id], onDelete: SetNull)
  activitySpot  ActivitySpot?  @relation(fields: [activitySpotId], references: [id], onDelete: SetNull)

  exercises           SessionExercise[]
  guidedSteps         GuidedStepLog[]
  metrics             RoutineLogMetric[]
  sessionMetricValues SessionLogMetricValue[]
  stimuli             RoutineLogStimulus[]
  zoneActivities      ZoneActivity[]
  painLogs            PainLog[]
  climbAttempts       ClimbAttempt[]

  createdAt DateTime @default(now())

  @@index([routineId, performedAt])
  @@index([climbLocationId])
  @@index([activitySpotId])
}

model BodyZone {
  id                String   @id @default(cuid())
  slug              String   @unique
  label             String
  region            String
  side              Side
  bodyView          BodyView
  metadataGroupSlug String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  activities  ZoneActivity[]
  painLogs    PainLog[]
  injuryZones InjuryZone[]
}

model ZoneActivity {
  id           String         @id @default(cuid())
  zoneId       String
  zone         BodyZone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  routineLogId String?
  routineLog   RoutineLog?    @relation(fields: [routineLogId], references: [id], onDelete: Cascade)
  performedAt  DateTime
  source       ActivitySource
  label        String
  intensity    String?
  notes        String?
  createdAt    DateTime       @default(now())

  @@index([zoneId, performedAt])
  @@index([routineLogId])
}

model PainLog {
  id           String      @id @default(cuid())
  zoneId       String
  zone         BodyZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  level        Int
  context      PainContext
  notes        String?
  loggedAt     DateTime    @default(now())
  routineLogId String?
  routineLog   RoutineLog? @relation(fields: [routineLogId], references: [id], onDelete: SetNull)

  @@index([zoneId, loggedAt])
  @@index([loggedAt])
}

model ActiveInjury {
  id         String       @id @default(cuid())
  name       String
  severity   Int
  status     InjuryStatus @default(ACTIVE)
  startedAt  DateTime
  resolvedAt DateTime?
  notes      String?
  zones      InjuryZone[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
}

model InjuryZone {
  id       String       @id @default(cuid())
  injuryId String
  injury   ActiveInjury @relation(fields: [injuryId], references: [id], onDelete: Cascade)
  zoneId   String
  zone     BodyZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([injuryId, zoneId])
}

model GuidedStep {
  id          String         @id @default(cuid())
  routineId   String
  kind        GuidedStepKind @default(STEP)
  title       String
  exerciseId  String?
  durationSec Int?
  restSec     Int?
  repeatCount Int            @default(1)
  repCount    Int            @default(1)
  setCount    Int            @default(1)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  routine        Routine                   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise       Exercise?                 @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  logSteps       GuidedStepLog[]
  metadataGroups GuidedStepMetadataGroup[]

  @@index([routineId, sortOrder])
  @@index([exerciseId])
}

model GuidedStepLog {
  id           String         @id @default(cuid())
  routineLogId String
  guidedStepId String?
  kind         GuidedStepKind @default(STEP)
  title        String
  exerciseId   String?
  durationSec  Int?
  restSec      Int?
  repeatCount  Int            @default(1)
  repCount     Int            @default(1)
  setCount     Int            @default(1)
  weightLb     Float?
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())

  routineLog RoutineLog  @relation(fields: [routineLogId], references: [id], onDelete: Cascade)
  guidedStep GuidedStep? @relation(fields: [guidedStepId], references: [id], onDelete: SetNull)
  exercise   Exercise?   @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([routineLogId, sortOrder])
  @@index([guidedStepId])
  @@index([exerciseId])
}

model RoutineLogMetric {
  id           String   @id @default(cuid())
  routineLogId String
  name         String
  value        Float
  unit         String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  routineLog RoutineLog @relation(fields: [routineLogId], references: [id], onDelete: Cascade)

  @@index([routineLogId, sortOrder])
}

model CardioRoutineDetails {
  id                  String   @id @default(cuid())
  routineId           String   @unique
  defaultDistanceUnit String   @default("mi")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model SessionRoutineDetails {
  id               String   @id @default(cuid())
  routineId        String   @unique
  templateId       String?
  templateConfig   Json?
  supportsLocation Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  routine  Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  template SessionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([templateId])
}

model SessionMetricDefinition {
  id             String                 @id @default(cuid())
  templateId     String
  key            String
  label          String
  valueType      SessionMetricValueType
  unit           String?
  sortOrder      Int                    @default(0)
  isRequired     Boolean                @default(false)
  showInProgress Boolean                @default(false)
  showInGoals    Boolean                @default(false)
  config         Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  template     SessionTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  metricValues SessionLogMetricValue[]

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

model SessionLogMetricValue {
  id                 String   @id @default(cuid())
  routineLogId       String
  metricDefinitionId String
  numberValue        Float?
  textValue          String?
  booleanValue       Boolean?
  createdAt          DateTime @default(now())

  routineLog       RoutineLog              @relation(fields: [routineLogId], references: [id], onDelete: Cascade)
  metricDefinition SessionMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@unique([routineLogId, metricDefinitionId])
  @@index([metricDefinitionId])
}

model SessionTemplateMetadataGroup {
  templateId String
  groupId    String
  assignedAt DateTime @default(now())

  template SessionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  group    MetadataGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([templateId, groupId])
  @@index([groupId])
}

model Exercise {
  id             String              @id @default(cuid())
  name           String              @unique
  unit           ExerciseUnit        @default(REPS)
  supportsWeight Boolean             @default(false)
  libraryKind    ExerciseLibraryKind @default(STRENGTH)
  isUnilateral   Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routines         RoutineExercise[]
  sessionExercises SessionExercise[]
  metadataGroups   ExerciseMetadataGroup[]
  guidedSteps      GuidedStep[]
  guidedStepLogs   GuidedStepLog[]
  triggeredGoals   FrequencyGoalTriggerExercise[]

  @@index([libraryKind, name])
}

model MetadataGroup {
  id                String            @id @default(cuid())
  slug              String            @unique
  label             String
  kind              MetadataGroupKind
  description       String?
  appliesToRoutine  Boolean           @default(false)
  appliesToExercise Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  parentRelations            MetadataGroupRelation[]        @relation("MetadataGroupParent")
  childRelations             MetadataGroupRelation[]        @relation("MetadataGroupChild")
  routineAssignments         RoutineMetadataGroup[]
  exerciseAssignments        ExerciseMetadataGroup[]
  sessionTemplateAssignments SessionTemplateMetadataGroup[]
  guidedStepAssignments      GuidedStepMetadataGroup[]
  stimulusMappings           MetadataStimulusMapping[]

  @@index([kind, label])
  @@index([appliesToRoutine])
  @@index([appliesToExercise])
}

model StimulusCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metadataMappings MetadataStimulusMapping[]
  logStimuli       RoutineLogStimulus[]
  preferences      UserStimulusPreference[]

  @@index([sortOrder, label])
}

model AppProfile {
  id                         String   @id @default(cuid())
  key                        String   @unique @default("default")
  selectedStimulusPresetKeys String[] @default([])
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  stimulusPreferences UserStimulusPreference[]
}

model UserStimulusPreference {
  id                 String   @id @default(cuid())
  profileId          String
  stimulusCategoryId String
  priorityWeight     Float    @default(1)
  maintenanceFloor   Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  profile          AppProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stimulusCategory StimulusCategory @relation(fields: [stimulusCategoryId], references: [id], onDelete: Cascade)

  @@unique([profileId, stimulusCategoryId])
  @@index([stimulusCategoryId])
}

model MetadataStimulusMapping {
  id                 String   @id @default(cuid())
  metadataGroupId    String
  stimulusCategoryId String
  loadWeight         Float    @default(0)
  stretchWeight      Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  metadataGroup    MetadataGroup    @relation(fields: [metadataGroupId], references: [id], onDelete: Cascade)
  stimulusCategory StimulusCategory @relation(fields: [stimulusCategoryId], references: [id], onDelete: Cascade)

  @@unique([metadataGroupId, stimulusCategoryId])
  @@index([stimulusCategoryId])
}

model RoutineLogStimulus {
  id                 String   @id @default(cuid())
  routineLogId       String
  stimulusCategoryId String
  loadValue          Float    @default(0)
  stretchValue       Float    @default(0)
  confidence         Float?
  sourceKind         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  routineLog       RoutineLog       @relation(fields: [routineLogId], references: [id], onDelete: Cascade)
  stimulusCategory StimulusCategory @relation(fields: [stimulusCategoryId], references: [id], onDelete: Cascade)

  @@unique([routineLogId, stimulusCategoryId])
  @@index([stimulusCategoryId])
}

model MetadataGroupRelation {
  parentGroupId String
  childGroupId  String
  createdAt     DateTime @default(now())

  parentGroup MetadataGroup @relation("MetadataGroupParent", fields: [parentGroupId], references: [id], onDelete: Cascade)
  childGroup  MetadataGroup @relation("MetadataGroupChild", fields: [childGroupId], references: [id], onDelete: Cascade)

  @@id([parentGroupId, childGroupId])
  @@index([childGroupId])
}

model RoutineMetadataGroup {
  routineId  String
  groupId    String
  assignedAt DateTime @default(now())

  routine Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  group   MetadataGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([routineId, groupId])
  @@index([groupId])
}

model ExerciseMetadataGroup {
  exerciseId String
  groupId    String
  assignedAt DateTime @default(now())

  exercise Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  group    MetadataGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, groupId])
  @@index([groupId])
}

model GuidedStepMetadataGroup {
  guidedStepId String
  groupId      String
  assignedAt   DateTime @default(now())

  guidedStep GuidedStep    @relation(fields: [guidedStepId], references: [id], onDelete: Cascade)
  group      MetadataGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([guidedStepId, groupId])
  @@index([groupId])
}

model RoutineTag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routines RoutineTagAssignment[]
}

model RoutineTagAssignment {
  routineId  String
  tagId      String
  assignedAt DateTime @default(now())

  routine Routine    @relation(fields: [routineId], references: [id], onDelete: Cascade)
  tag     RoutineTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([routineId, tagId])
  @@index([tagId])
}

model RoutineExercise {
  id         String @id @default(cuid())
  routineId  String
  exerciseId String
  sortOrder  Int    @default(0)

  // this is the "remember 4 rows next time" value
  defaultSets Int @default(3)

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routineId, exerciseId])
  @@index([routineId, sortOrder])
}

model SessionExercise {
  id           String @id @default(cuid())
  routineLogId String
  exerciseId   String

  routineLog RoutineLog @relation(fields: [routineLogId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  sets SetEntry[]

  createdAt DateTime @default(now())

  @@index([routineLogId])
  @@index([exerciseId])
}

model SetEntry {
  id                String @id @default(cuid())
  sessionExerciseId String
  setNumber         Int

  reps     Int?
  seconds  Int?
  weightLb Float?

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sessionExerciseId, setNumber])
  @@index([sessionExerciseId])
}

model Goal {
  id          String         @id @default(cuid())
  name        String
  goalType    GoalType
  targetType  GoalTargetType
  targetId    String
  metricType  GoalMetricType
  targetValue Float
  timeframe   GoalTimeframe
  unit        String?
  startDate   DateTime       @default(now())
  endDate     DateTime?
  isActive    Boolean        @default(true)
  notes       String?
  config      Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isActive, goalType])
  @@index([targetType, targetId])
  @@index([timeframe, startDate, endDate])
}

model FrequencyGoal {
  id             String               @id @default(cuid())
  name           String
  targetCount    Int
  targetInterval Int
  targetUnit     RoutineFrequencyUnit
  // Weekday bitmask: bit 0 = Sun, bit 1 = Mon, ..., bit 6 = Sat. Null/zero
  // means "any day counts" (flexible weekly target). Only meaningful when
  // targetUnit = WEEK; ignored for DAY/MONTH targets.
  weekdayMask    Int?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Optional broaden-the-net config. A log counts toward this goal when
  // log.routineId is in `routines` (existing PRIMARY/SUBSTITUTE) OR the
  // log's routine has a subtype in `triggerSubtypes` OR any exercise inside
  // the log is in `triggerExercises`. Used to catch ad-hoc / quick logs
  // that aren't members of a saved routine the user already listed.
  triggerSubtypes  String[]                       @default([])
  triggerExercises FrequencyGoalTriggerExercise[]
  // Minimum number of trigger-exercise sets a log must contain to claim a
  // session via the exercise-trigger path. 1 = any set counts (default).
  // Higher values stop a single warmup pull-up from claiming a Pull
  // Strength session. Ignored for routine-id and subtype matches —
  // they're already routine-level claims.
  triggerMinSets   Int                            @default(1)

  routines FrequencyGoalRoutine[]

  @@index([isActive])
}

model FrequencyGoalRoutine {
  goalId    String
  routineId String
  // PRIMARY: counts as a real completion of the goal — what the habit is
  // really tracking. SUBSTITUTE: another routine that satisfies the day
  // (so the streak doesn't break) but renders as "covered by" instead of
  // "done" in the heatmap. Default PRIMARY keeps existing rows unchanged.
  role      FrequencyGoalRole @default(PRIMARY)
  addedAt   DateTime          @default(now())

  goal    FrequencyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  routine Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([goalId, routineId])
  @@index([routineId])
}

// Exercise-based "also count when these appear" rule. A goal with even one
// row here will pick up any log that contains the exercise — including quick
// workout logs that aren't part of an enrolled routine. See the matcher in
// lib/frequency-goals.ts for the OR'd evaluation order.
model FrequencyGoalTriggerExercise {
  goalId     String
  exerciseId String
  addedAt    DateTime @default(now())

  goal     FrequencyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  exercise Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([goalId, exerciseId])
  @@index([exerciseId])
}

enum FrequencyGoalRole {
  PRIMARY
  SUBSTITUTE
}

// Lightweight, date-bound to-do items for "random not-important" things the
// user wants to check off for a specific day (e.g., laundry, doctor's
// appointment). Distinct from routines/habits — no streak math, no history
// of completion patterns; once done it just sits checked off on its day.
model DayTodo {
  id        String   @id @default(cuid())
  ymd       String   // app-tz YYYY-MM-DD the todo belongs to
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ymd, done])
  @@index([done, ymd])
}
