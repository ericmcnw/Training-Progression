  notes       String?
  config      Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isActive, goalType])
  @@index([targetType, targetId])
  @@index([timeframe, startDate, endDate])
}

model FrequencyGoal {
  id             String               @id @default(cuid())
  name           String
  targetCount    Int
  targetInterval Int
  targetUnit     RoutineFrequencyUnit
  // Weekday bitmask: bit 0 = Sun, bit 1 = Mon, ..., bit 6 = Sat. Null/zero
  // means "any day counts" (flexible weekly target). Only meaningful when
  // targetUnit = WEEK; ignored for DAY/MONTH targets.
  weekdayMask    Int?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Optional broaden-the-net config. A log counts toward this goal when
  // log.routineId is in `routines` (existing PRIMARY/SUBSTITUTE) OR the
  // log's routine has a subtype in `triggerSubtypes` OR the log has an
  // activityTypeId in `triggerActivityTypeIds` OR the log's activity type
  // belongs to a family in `triggerActivityFamilyIds` OR any exercise
  // inside the log is in `triggerExercises`. Used to catch ad-hoc / quick
  // logs that aren't members of a saved routine the user already listed.
  // Activity-type triggers are the v1 entry point for endurance goals —
  // e.g. "Run 3x/wk" sets triggerActivityFamilyIds=[<running>] and any
  // run-family log counts.
  triggerSubtypes          String[]                       @default([])
  triggerActivityTypeIds   String[]                       @default([])
  triggerActivityFamilyIds String[]                       @default([])
  triggerExercises         FrequencyGoalTriggerExercise[]
  // Minimum number of trigger-exercise sets a log must contain to claim a
  // session via the exercise-trigger path. 1 = any set counts (default).
  // Higher values stop a single warmup pull-up from claiming a Pull
  // Strength session. Ignored for routine-id and subtype matches —
  // they're already routine-level claims.
  triggerMinSets   Int                            @default(1)

  routines FrequencyGoalRoutine[]

  @@index([isActive])
}

model FrequencyGoalRoutine {
  goalId    String
  routineId String
  // PRIMARY: counts as a real completion of the goal — what the habit is
  // really tracking. SUBSTITUTE: another routine that satisfies the day
  // (so the streak doesn't break) but renders as "covered by" instead of
  // "done" in the heatmap. Default PRIMARY keeps existing rows unchanged.
  role      FrequencyGoalRole @default(PRIMARY)
  addedAt   DateTime          @default(now())

  goal    FrequencyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  routine Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([goalId, routineId])
  @@index([routineId])
}

// Exercise-based "also count when these appear" rule. A goal with even one
// row here will pick up any log that contains the exercise — including quick
// workout logs that aren't part of an enrolled routine. See the matcher in
// lib/frequency-goals.ts for the OR'd evaluation order.
model FrequencyGoalTriggerExercise {
  goalId     String
  exerciseId String
  addedAt    DateTime @default(now())

  goal     FrequencyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  exercise Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([goalId, exerciseId])
  @@index([exerciseId])
}

enum FrequencyGoalRole {
  PRIMARY
  SUBSTITUTE
}

// Lightweight, date-bound to-do items for "random not-important" things the
// user wants to check off for a specific day (e.g., laundry, doctor's
// appointment). Distinct from routines/habits — no streak math, no history
// of completion patterns; once done it just sits checked off on its day.
model DayTodo {
  id        String   @id @default(cuid())
  ymd       String   // app-tz YYYY-MM-DD the todo belongs to
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ymd, done])
  @@index([done, ymd])
}
