enum LoadUnit {
  LB
  KG
  PCT_1RM
  RPE
  STACK
  BODYWEIGHT
}

// What you're SUPPOSED to do, as opposed to SessionExercise/SetEntry which
// record what you did. Attached to RoutineExercise it's the routine's default
// prescription; a later Block layer overrides it per training week.
model Prescription {
  id                String @id @default(cuid())
  routineExerciseId String @unique

  sets     Int?
  repsMin  Int?
  repsMax  Int?
  seconds  Int?
  load     Float?
  loadUnit LoadUnit @default(LB)
  tempo    String?
  restSec  Int?
  cue      String?

  routineExercise RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

